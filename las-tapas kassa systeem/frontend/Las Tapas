<style>
  :root {
    --wine: #6B1E2A;
    --wine-dark: #2B0F16;
    --panel: #3B1620;
    --panel-2: #451A26;
    --saffron: #D98B45;
    --saffron-light: #E9AE72;
    --olive: #9CB379;
    --olive-dark: #6E7B4A;
    --charcoal: #1E0B10;
    --parchment: #2B0F16;
    --parchment-warm: #3B1620;
    --cream-text: #F5EAD9;
    --muted: #C9A98E;
    --font-display: 'Fraunces', serif;
    --font-body: 'Work Sans', sans-serif;
    --bg: var(--parchment);
    --fg: var(--cream-text);
    box-sizing: border-box;
    padding-top: env(safe-area-inset-top, 0px);
    padding-bottom: env(safe-area-inset-bottom, 0px);
  }
  * { box-sizing: border-box; }
  html { scroll-behavior: smooth; scroll-padding-top: env(safe-area-inset-top, 80px); }
  body { margin: 0; background: var(--bg); color: var(--fg); font-family: var(--font-body); line-height: 1.5; -webkit-font-smoothing: antialiased; }
  img, svg { max-width: 100%; display: block; }
  .wrap { max-width: 1180px; margin: 0 auto; padding: 0 28px; }
  header.site { position: sticky; top: env(safe-area-inset-top, 0px); z-index: 50; background: var(--panel-2); color: var(--cream-text); border-bottom: 1px solid rgba(217,139,69,0.4); }
  .nav-inner { display: flex; align-items: center; justify-content: space-between; padding: 14px 28px; max-width: 1180px; margin: 0 auto; gap: 16px; }
  .brand { font-family: var(--font-display); font-weight: 700; font-size: 1.5rem; letter-spacing: 0.01em; color: var(--cream-text); text-decoration: none; display: flex; align-items: baseline; gap: 8px; background: none; border: none; padding: 0; margin: 0; cursor: pointer; }
  .brand .dot { color: var(--saffron); }
  nav.links { display: flex; gap: 8px; flex-wrap: wrap; }
  nav.links button { font-family: var(--font-body); color: var(--cream-text); background: transparent; border: 1.5px solid transparent; cursor: pointer; text-decoration: none; font-size: 0.98rem; font-weight: 500; opacity: 0.85; padding: 8px 14px; border-radius: 999px; transition: background 0.2s ease, opacity 0.2s ease; }
  nav.links button:hover, nav.links button:focus-visible { opacity: 1; background: rgba(245,234,217,0.08); }
  nav.links button[aria-current="page"] { opacity: 1; background: rgba(217,139,69,0.15); border: 1.5px solid var(--saffron); color: var(--saffron-light); font-weight: 700; }
  .nav-toggle { display: none; background: transparent; border: 1.5px solid rgba(251,243,231,0.5); color: var(--cream-text); border-radius: 4px; padding: 8px 12px; font-size: 1.1rem; cursor: pointer; }
  @media (max-width: 720px) {
    nav.links { display: none; position: absolute; top: 100%; left: 0; right: 0; background: var(--panel-2); flex-direction: column; padding: 10px 28px 18px; border-bottom: 3px solid var(--saffron); }
    nav.links.open { display: flex; }
    nav.links button { text-align: left; border-radius: 4px; }
    .nav-toggle { display: block; }
  }
  .hero { position: relative; background: var(--wine-dark); color: var(--cream-text); overflow: hidden; padding: 88px 0 64px; }
  .hero::before { content: ""; position: absolute; inset: 0; background-image: radial-gradient(circle at 15% 20%, rgba(224,162,63,0.18) 0, transparent 45%), radial-gradient(circle at 85% 80%, rgba(110,123,74,0.22) 0, transparent 50%); pointer-events: none; }
  .hero-grid { position: relative; display: grid; grid-template-columns: 1.15fr 0.85fr; gap: 56px; align-items: center; }
  @media (max-width: 860px) { .hero-grid { grid-template-columns: 1fr; gap: 40px; } }
  .eyebrow-plain { font-size: 0.95rem; color: var(--saffron-light); margin: 0 0 10px; font-weight: 500; }
  .hero h1 { font-family: var(--font-display); font-size: clamp(2.8rem, 6vw, 4.6rem); line-height: 0.98; margin: 0 0 20px; font-weight: 600; }
  .hero p.lede { font-size: 1.15rem; max-width: 46ch; color: rgba(251,243,231,0.88); margin: 0 0 30px; }
  .hero-actions { display: flex; gap: 14px; flex-wrap: wrap; }
  .btn { display: inline-block; padding: 13px 26px; border-radius: 3px; font-weight: 600; text-decoration: none; font-size: 0.98rem; font-family: inherit; border: none; cursor: pointer; transition: transform 0.15s ease, box-shadow 0.15s ease; }
  .btn-primary { background: var(--saffron); color: var(--wine-dark); }
  .btn-primary:hover { transform: translateY(-2px); box-shadow: 0 6px 18px rgba(224,162,63,0.35); }
  .btn-ghost { background: transparent; color: var(--cream-text); border: 1.5px solid rgba(251,243,231,0.5); }
  .btn-ghost:hover { border-color: var(--saffron); transform: translateY(-2px); }
  .hero-tile { position: relative; aspect-ratio: 4/5; border-radius: 4px; overflow: hidden; box-shadow: 0 30px 60px -20px rgba(0,0,0,0.5); }
  .hours-strip { margin-top: 44px; display: flex; gap: 28px; flex-wrap: wrap; padding-top: 26px; border-top: 1px solid rgba(251,243,231,0.22); }
  .hours-strip .item { font-size: 0.92rem; color: rgba(251,243,231,0.82); }
  .hours-strip .item strong { display: block; color: var(--saffron-light); font-size: 0.82rem; margin-bottom: 3px; font-weight: 600; }
  .page { display: none; }
  .page.active { display: block; animation: pagein 0.32s ease; }
  @keyframes pagein { from { opacity: 0; transform: translateY(10px);} to { opacity: 1; transform: translateY(0);} }
  section { padding: 84px 0; }
  .section-head { display: grid; grid-template-columns: auto 1fr; align-items: end; gap: 24px; margin-bottom: 48px; }
  .section-head h2 { font-family: var(--font-display); font-size: clamp(2rem, 4vw, 2.7rem); margin: 0; font-weight: 600; }
  .section-head .num { font-family: var(--font-display); font-size: 3.4rem; color: var(--saffron); opacity: 0.55; font-weight: 400; line-height: 1; }
  .section-head p { margin: 6px 0 0; opacity: 0.75; max-width: 52ch; }
  .rule { height: 1px; background: currentColor; opacity: 0.15; margin: 8px 0 0; }
  .about-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 56px; align-items: center; }
  @media (max-width: 820px) { .about-grid { grid-template-columns: 1fr; } }
  .about-grid p { font-size: 1.05rem; opacity: 0.86; margin: 0 0 16px; max-width: 54ch; }
  .tile-pattern { aspect-ratio: 1/1; border-radius: 4px; }
  .menu-tabs { display: flex; gap: 10px; flex-wrap: wrap; margin-bottom: 40px; }
  .formula-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 22px; margin-bottom: 8px; }
  @media (max-width: 860px) { .formula-grid { grid-template-columns: 1fr; } }
  .formula-card { background: var(--panel); border: 1.5px solid rgba(245,234,217,0.14); border-radius: 6px; padding: 28px 26px; position: relative; }
  .formula-card.featured { border-color: var(--saffron); background: var(--panel-2); }
  .formula-duur { display: inline-block; font-size: 0.72rem; font-weight: 700; letter-spacing: 0.06em; text-transform: uppercase; color: var(--saffron-light); background: rgba(217,139,69,0.14); border-radius: 999px; padding: 4px 12px; margin: 0 0 14px; }
  .formula-card h3 { font-family: var(--font-display); font-size: 1.35rem; font-weight: 600; margin: 0 0 10px; line-height: 1.2; }
  .formula-desc { font-size: 0.92rem; opacity: 0.78; margin: 0 0 20px; min-height: 60px; }
  .formula-price { font-family: var(--font-display); font-size: 1.7rem; font-weight: 700; color: var(--saffron-light); margin: 0; }
  .formula-price span { font-family: var(--font-body); font-size: 0.85rem; font-weight: 500; opacity: 0.65; margin-left: 4px; }
  .menu-tabs button { font-family: var(--font-body); font-size: 0.92rem; font-weight: 600; padding: 9px 18px; border-radius: 999px; border: 1.5px solid var(--saffron); background: transparent; color: var(--saffron-light); cursor: pointer; transition: background 0.18s ease, color 0.18s ease; }
  .menu-tabs button[aria-selected="true"] { background: var(--saffron); color: var(--wine-dark); border-color: var(--saffron); }
  .menu-panel { display: none; }
  .menu-panel.active { display: block; animation: fadein 0.35s ease; }
  @keyframes fadein { from { opacity: 0; transform: translateY(6px);} to { opacity: 1; transform: translateY(0);} }
  .dish-list { display: grid; gap: 0; }
  .dish { display: grid; grid-template-columns: 1fr; gap: 4px; padding: 16px 0; border-bottom: 1px solid rgba(245,234,217,0.15); }
  .dish-name { font-family: var(--font-display); font-size: 1.18rem; font-weight: 600; margin: 0; }
  .dish-price { font-family: var(--font-display); font-size: 1.18rem; font-weight: 600; color: var(--saffron-light); white-space: nowrap; }
  .dish-desc { grid-column: 1 / -1; margin: 0; font-size: 0.94rem; opacity: 0.72; max-width: 60ch; }
  .dish-tag { display: inline-block; font-size: 0.72rem; font-weight: 600; color: var(--olive); margin-left: 8px; }
  .info-grid { display: grid; grid-template-columns: 0.9fr 1.1fr; gap: 60px; }
  @media (max-width: 860px) { .info-grid { grid-template-columns: 1fr; } }
  .hours-table { width: 100%; border-collapse: collapse; }
  .hours-table tr { border-bottom: 1px solid rgba(245,234,217,0.15); }
  .hours-table td { padding: 13px 0; font-size: 1.02rem; }
  .hours-table td:first-child { font-weight: 600; }
  .hours-table td:last-child { text-align: right; opacity: 0.85; }
  .hours-table tr.today td { color: var(--saffron); font-weight: 700; }
  .kitchen-note { margin-top: 22px; font-size: 0.9rem; opacity: 0.65; font-style: italic; }
  .map-card { border: 1.5px solid rgba(245,234,217,0.2); border-radius: 4px; overflow: hidden; }
  .map-illustration { background: var(--panel); }
  .map-details { padding: 26px 28px; background: var(--panel-2); }
  .map-details h3 { font-family: var(--font-display); margin: 0 0 4px; font-size: 1.3rem; }
  .map-details address { font-style: normal; opacity: 0.8; margin-bottom: 14px; line-height: 1.6; }
  .map-details .directions { font-size: 0.92rem; opacity: 0.72; margin: 0; }
  .venue-stats { display: flex; gap: 28px; flex-wrap: wrap; margin-top: 18px; padding-top: 18px; border-top: 1px solid rgba(245,234,217,0.15); }
  .venue-stats .stat strong { display: block; font-family: var(--font-display); font-size: 1.5rem; color: var(--saffron-light); }
  .venue-stats .stat span { font-size: 0.85rem; opacity: 0.7; }
  .cta-band { background: var(--panel-2); color: var(--cream-text); text-align: center; padding: 72px 0; border-top: 1px solid rgba(245,234,217,0.12); border-bottom: 1px solid rgba(245,234,217,0.12); }
  .cta-band h2 { font-family: var(--font-display); font-size: clamp(2rem, 4.5vw, 2.9rem); margin: 0 0 14px; font-weight: 600; }
  .cta-band p { max-width: 50ch; margin: 0 auto 30px; opacity: 0.88; }
  .privacy-note { max-width: 48ch; margin: 30px auto 0; padding-top: 22px; border-top: 1px solid rgba(245,234,217,0.18); font-size: 0.82rem; opacity: 0.62; line-height: 1.55; }
  footer { background: var(--charcoal); color: rgba(251,243,231,0.75); padding: 48px 0 28px; font-size: 0.9rem; }
  .footer-grid { display: grid; grid-template-columns: 1.3fr 1fr 1fr; gap: 32px; margin-bottom: 32px; }
  @media (max-width: 700px) { .footer-grid { grid-template-columns: 1fr; } }
  footer h4 { color: var(--cream-text); font-size: 0.85rem; margin: 0 0 12px; font-weight: 600; }
  footer p, footer address { margin: 0 0 8px; font-style: normal; opacity: 0.85; }
  footer .brand { font-size: 1.2rem; margin-bottom: 10px; }
  .footer-bottom { border-top: 1px solid rgba(251,243,231,0.12); padding-top: 20px; display: flex; justify-content: space-between; flex-wrap: wrap; gap: 10px; opacity: 0.6; font-size: 0.82rem; }
  @media (prefers-reduced-motion: reduce) { * { animation-duration: 0.01ms !important; transition-duration: 0.01ms !important; } }
  :focus-visible { outline: 2.5px solid var(--saffron); outline-offset: 2px; }
</style>
</head>
